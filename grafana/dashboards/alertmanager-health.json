{
  "uid": "alertmanager-health",
  "title": "Alertmanager Health",
  "description": "Viewed every round by the lab viewer. Every panel has a 1m minimum interval, while the alertmanager job is scraped every 15s: a lower-resolution finding (tvt S3).",
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "tags": [
    "tvt-lab"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "timezone": "browser",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Alerts by state",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "interval": "1m",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (state) (alertmanager_alerts)",
          "legendFormat": "{{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Notifications per minute by integration",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "interval": "1m",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (integration) (rate(alertmanager_notifications_total[1m]))",
          "legendFormat": "{{integration}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ]
}
