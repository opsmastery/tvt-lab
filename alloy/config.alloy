// tvt-lab's Alloy pipeline (tvt Sprint 2 item 14, ADR 0007). This directory
// stands in for a pipeline config repo: tvt.yaml's pipelines: names it
// (alloy-apps) with the signals it handles, {job=~"shop|node"} metrics and
// {app="shop"} streams. Prometheus still scrapes itself and the backends
// (prometheus/scrape/lab.yml: the prometheus-scrape pipeline).
//
// Series keep the labels they had when Prometheus scraped them (job from
// job_name, instance from the address), so history continues across the
// switch (Nov 15, 2026).
//
// Everything also goes to prometheus.relabel "cloud" and loki.process
// "cloud", defined by the output file compose mounts beside this one
// (outputs/<ALLOY_OUTPUT>.alloy): local (the default) drops it all, cloud
// forwards a free-tier subset to the Grafana Cloud test stack.

prometheus.scrape "shop" {
  targets         = [{"__address__" = "shop:8080"}]
  job_name        = "shop"
  scrape_interval = "10s"
  forward_to      = [prometheus.relabel.apps.receiver]
}

prometheus.scrape "node" {
  targets         = [{"__address__" = "node-exporter:9100"}]
  job_name        = "node"
  scrape_interval = "10s"
  forward_to      = [prometheus.relabel.apps.receiver]
}

// Where tvt's proposals for Alloy-scraped metrics land (ADR 0007:
// prometheus.relabel blocks). The first rule matches no metric. The second
// renames the shop's search counter before it's stored (tvt S7 item 9): only
// the new name, shop_search_requests_total, is in Prometheus, and only Shop
// Overview panel 10 reads it, so tvt must match readers on the stored name.
prometheus.relabel "apps" {
  rule {
    source_labels = ["__name__"]
    regex         = "tvt_lab_no_such_metric"
    action        = "drop"
  }
  rule {
    source_labels = ["__name__"]
    regex         = "shop_search_queries_total"
    target_label  = "__name__"
    replacement   = "shop_search_requests_total"
    action        = "replace"
  }
  // Sets a label from another (tvt S7 item 9, label rules): tvt doesn't place
  // a label removal around a rule that sets a label, so instance_pod is held
  // on every metric that passes here, never proposed.
  rule {
    source_labels = ["instance"]
    target_label  = "instance_pod"
    action        = "replace"
  }
  // tvt:begin alloy-apps scan=1 evidence=36a144b94c6e
  // 279 unread metrics, 1 unread label, see tvt why; saves 642.82 USD/month
  rule {
    source_labels = ["__name__"]
    regex         = "node_arp_entries|node_boot_time_seconds|node_cpu_guest_seconds_total|node_cpu_online|node_disk_discard_time_seconds_total|node_disk_discarded_sectors_total|node_disk_discards_completed_total|node_disk_discards_merged_total|node_disk_flush_requests_time_seconds_total|node_disk_flush_requests_total|node_disk_info|node_disk_io_now|node_disk_io_time_seconds_total|node_disk_io_time_weighted_seconds_total|node_disk_read_bytes_total|node_disk_read_time_seconds_total|node_disk_reads_completed_total|node_disk_reads_merged_total|node_disk_write_time_seconds_total|node_disk_writes_completed_total|node_disk_writes_merged_total|node_disk_written_bytes_total|node_dmi_info|node_entropy_available_bits|node_entropy_pool_size_bits|node_exporter_build_info|node_filefd_allocated|node_filefd_maximum|node_filesystem_avail_bytes|node_filesystem_files|node_filesystem_files_free|node_filesystem_free_bytes|node_filesystem_mount_info|node_filesystem_purgeable_bytes|node_filesystem_readonly|node_filesystem_size_bytes|node_forks_total|node_intr_total|node_load1|node_load5|node_memory_Active_anon_bytes|node_memory_Active_bytes|node_memory_Active_file_bytes|node_memory_AnonHugePages_bytes|node_memory_AnonPages_bytes|node_memory_Bounce_bytes|node_memory_Buffers_bytes|node_memory_Cached_bytes|node_memory_CmaFree_bytes|node_memory_CmaTotal_bytes|node_memory_CommitLimit_bytes|node_memory_Committed_AS_bytes|node_memory_Dirty_bytes|node_memory_HardwareCorrupted_bytes|node_memory_HugePages_Free|node_memory_HugePages_Rsvd|node_memory_HugePages_Surp|node_memory_HugePages_Total|node_memory_Hugepagesize_bytes|node_memory_Inactive_anon_bytes|node_memory_Inactive_bytes|node_memory_Inactive_file_bytes|node_memory_KernelStack_bytes|node_memory_Mapped_bytes|node_memory_MemAvailable_bytes|node_memory_MemFree_bytes|node_memory_MemTotal_bytes|node_memory_Mlocked_bytes|node_memory_NFS_Unstable_bytes|node_memory_PageTables_bytes|node_memory_Percpu_bytes|node_memory_SReclaimable_bytes|node_memory_SUnreclaim_bytes|node_memory_ShmemHugePages_bytes|node_memory_ShmemPmdMapped_bytes|node_memory_Shmem_bytes|node_memory_Slab_bytes|node_memory_SwapCached_bytes|node_memory_SwapFree_bytes|node_memory_SwapTotal_bytes|node_memory_Unevictable_bytes|node_memory_VmallocChunk_bytes|node_memory_VmallocTotal_bytes|node_memory_VmallocUsed_bytes|node_memory_WritebackTmp_bytes|node_memory_Writeback_bytes|node_netstat_Icmp6_InErrors|node_netstat_Icmp6_InMsgs|node_netstat_Icmp6_OutMsgs|node_netstat_Icmp_InErrors|node_netstat_Icmp_InMsgs|node_netstat_Icmp_OutMsgs|node_netstat_Ip6_InOctets|node_netstat_Ip6_OutOctets|node_netstat_IpExt_InOctets|node_netstat_IpExt_OutOctets|node_netstat_Ip_Forwarding|node_netstat_TcpExt_ListenDrops|node_netstat_TcpExt_ListenOverflows|node_netstat_TcpExt_SyncookiesFailed|node_netstat_TcpExt_SyncookiesRecv|node_netstat_TcpExt_SyncookiesSent|node_netstat_TcpExt_TCPOFOQueue|node_netstat_TcpExt_TCPRcvQDrop|node_netstat_TcpExt_TCPSynRetrans|node_netstat_TcpExt_TCPTimeouts|node_netstat_Tcp_ActiveOpens|node_netstat_Tcp_CurrEstab|node_netstat_Tcp_InErrs|node_netstat_Tcp_InSegs|node_netstat_Tcp_OutRsts|node_netstat_Tcp_OutSegs|node_netstat_Tcp_PassiveOpens|node_netstat_Tcp_RetransSegs|node_netstat_Udp6_InDatagrams|node_netstat_Udp6_InErrors|node_netstat_Udp6_NoPorts|node_netstat_Udp6_OutDatagrams|node_netstat_Udp6_RcvbufErrors|node_netstat_Udp6_SndbufErrors|node_netstat_Udp_InDatagrams|node_netstat_Udp_InErrors|node_netstat_Udp_NoPorts|node_netstat_Udp_OutDatagrams|node_netstat_Udp_RcvbufErrors|node_netstat_Udp_SndbufErrors|node_network_address_assign_type|node_network_carrier|node_network_carrier_changes_total|node_network_carrier_down_changes_total|node_network_carrier_up_changes_total|node_network_device_id|node_network_dormant|node_network_flags|node_network_iface_id|node_network_iface_link|node_network_iface_link_mode|node_network_info|node_network_mtu_bytes|node_network_name_assign_type|node_network_net_dev_group|node_network_protocol_type|node_network_receive_bytes_total|node_network_receive_compressed_total|node_network_receive_drop_total|node_network_receive_fifo_total|node_network_receive_frame_total|node_network_receive_multicast_total|node_network_receive_nohandler_total|node_network_receive_packets_total|node_network_speed_bytes|node_network_transmit_bytes_total|node_network_transmit_carrier_total|node_network_transmit_colls_total|node_network_transmit_compressed_total|node_network_transmit_drop_total|node_network_transmit_fifo_total|node_network_transmit_packets_total|node_network_up|node_nf_conntrack_entries|node_nf_conntrack_entries_limit|node_nf_conntrack_stat_drop|node_nf_conntrack_stat_early_drop|node_nf_conntrack_stat_found|node_nf_conntrack_stat_ignore|node_nf_conntrack_stat_insert|node_nf_conntrack_stat_invalid|node_nf_conntrack_stat_search_restart|node_pressure_cpu_waiting_seconds_total|node_pressure_io_stalled_seconds_total|node_pressure_io_waiting_seconds_total|node_pressure_irq_stalled_seconds_total|node_pressure_memory_stalled_seconds_total|node_pressure_memory_waiting_seconds_total|node_procs_blocked|node_procs_running|node_schedstat_running_seconds_total|node_schedstat_timeslices_total|node_schedstat_waiting_seconds_total|node_scrape_collector_success|node_selinux_enabled|node_sockstat_FRAG6_inuse|node_sockstat_FRAG6_memory|node_sockstat_FRAG_inuse|node_sockstat_FRAG_memory|node_sockstat_RAW6_inuse|node_sockstat_RAW_inuse|node_sockstat_TCP6_inuse|node_sockstat_TCP_alloc|node_sockstat_TCP_inuse|node_sockstat_TCP_mem|node_sockstat_TCP_mem_bytes|node_sockstat_TCP_orphan|node_sockstat_TCP_tw|node_sockstat_UDP6_inuse|node_sockstat_UDP_inuse|node_sockstat_UDP_mem|node_sockstat_UDP_mem_bytes|node_sockstat_sockets_used|node_softnet_cpu_collision_total|node_softnet_dropped_total|node_softnet_flow_limit_count_total|node_softnet_processed_total|node_softnet_received_rps_total|node_softnet_times_squeezed_total|node_time_clocksource_available_info|node_time_clocksource_current_info|node_time_seconds|node_time_zone_offset_seconds|node_timex_frequency_adjustment_ratio|node_timex_loop_time_constant|node_timex_maxerror_seconds|node_timex_offset_seconds|node_timex_pps_calibration_total|node_timex_pps_frequency_hertz|node_timex_pps_jitter_seconds|node_timex_pps_jitter_total|node_timex_pps_shift_seconds|node_timex_pps_stability_exceeded_total|node_timex_pps_stability_hertz|node_timex_status|node_timex_sync_status|node_timex_tai_offset_seconds|node_timex_tick_seconds|node_udp_queues|node_uname_info|node_vmstat_pgfault|node_vmstat_pgmajfault|node_vmstat_pgpgin|node_vmstat_pgpgout|node_vmstat_pswpin|node_vmstat_pswpout|python_gc_collections_total|python_gc_objects_collected_total|python_gc_objects_uncollectable_total|python_info|shop_cache_aof_rewrite_seconds|shop_cache_blocked_clients|shop_cache_bytes_read|shop_cache_bytes_written|shop_cache_commands_processed|shop_cache_connections|shop_cache_cpu_sys_seconds|shop_cache_cpu_user_seconds|shop_cache_expirations|shop_cache_fragmentation_ratio|shop_cache_hits_created|shop_cache_hits_ratio|shop_cache_hits_total|shop_cache_items|shop_cache_keyspace_hits|shop_cache_keyspace_misses|shop_cache_lua_memory_bytes|shop_cache_memory_peak_bytes|shop_cache_memory_rss_bytes|shop_cache_net_input_bytes|shop_cache_net_output_bytes|shop_cache_pubsub_channels|shop_cache_rdb_changes_since_save|shop_cache_rejected_connections|shop_cache_requests_created|shop_cache_requests_total|shop_cache_size_bytes|shop_cache_slowlog_length|shop_cache_uptime_seconds|shop_cart_operation_created|shop_cart_operation_total|shop_cart_operations_created|shop_checkout_attempts_created|shop_feature_flag_evaluations_created|shop_feature_flag_evaluations_total|shop_healthcheck_checks_created|shop_healthcheck_duration_seconds_created|shop_http_request_duration_seconds_created|shop_http_requests_created|shop_payment_gateway_retries_created|shop_revenue_dollars_created|shop_revenue_dollars_total|shop_search_queries_created"
    action        = "drop"
  }
  rule {
    source_labels = ["__name__"]
    regex         = "shop_cart_operations_total"
    target_label  = "op_kind"
    replacement   = ""
    action        = "replace"
  }
  // tvt:end
  forward_to = [prometheus.remote_write.prometheus.receiver, prometheus.relabel.cloud.receiver]
}

prometheus.remote_write "prometheus" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}

// The shop's traces (OTLP/HTTP on :4318) become span metrics (tvt S6 item 5).
// customer.id is a dimension with a cardinality limit below the shop's 500
// customers, so the metrics overflow: past the limit, new combinations go to
// one series per metric with otel.metric.overflow="true" and no dimensions
// (otel_metric_overflow in Prometheus). The span metrics join the apps path,
// so tvt's proposals for them land in prometheus.relabel "apps" too.
otelcol.receiver.otlp "shop" {
  http {
    endpoint = "0.0.0.0:4318"
  }
  output {
    traces = [otelcol.connector.spanmetrics.shop.input]
  }
}

otelcol.connector.spanmetrics "shop" {
  dimension {
    name = "http.route"
  }
  dimension {
    name = "customer.id"
  }
  histogram {
    unit = "s"
    explicit {
      buckets = ["0.05s", "0.1s", "0.25s", "0.5s", "1s", "2.5s"]
    }
  }
  aggregation_cardinality_limit = 100
  output {
    metrics = [otelcol.exporter.prometheus.shop.input]
  }
}

otelcol.exporter.prometheus "shop" {
  forward_to = [prometheus.relabel.spans.receiver]
}

// A rule tvt can't follow (tvt S7 item 9, ADR 0013): its regex comes from the
// environment (TVT_LAB_SPANS_DROP_REGEX in compose.yaml, set to a name no
// metric has). tvt must treat every signal that passes it, the span metrics
// and target_info, as an evidence gap: never a reader, never a safe drop.
prometheus.relabel "spans" {
  rule {
    source_labels = ["__name__"]
    regex         = sys.env("TVT_LAB_SPANS_DROP_REGEX")
    action        = "drop"
  }
  forward_to = [prometheus.relabel.apps.receiver]
}

// The shop pushes its logs here (Loki push API on :3500) instead of to Loki.
// The reconciler doesn't: it pushes straight to Loki, the lab's one signal
// no pipeline claims.
loki.source.api "shop" {
  http {
    listen_address = "0.0.0.0"
    listen_port    = 3500
  }
  use_incoming_timestamp = true
  forward_to             = [loki.process.apps.receiver]
}

// Where tvt's proposals for Alloy-shipped streams land (ADR 0007:
// loki.process blocks). Today it passes every line through.
loki.process "apps" {
  // tvt:begin reroute:loki:stream:{app="shop", component="worker", level="debug", service_name="shop"} scan=1 evidence=f3e6f52936ee
  // tvt:original forward_to = [loki.write.loki.receiver, loki.process.cloud.receiver]
  forward_to = [loki.relabel.tvt_hot.receiver, loki.relabel.tvt_cold.receiver]
  // tvt:end
}

// The lab's cold tier for Alloy streams (tvt S7, pipelines[].cold): a stand-in
// for an archive. Nothing forwards here until tvt's reroute block does.
loki.echo "cold" { }

loki.write "loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
// tvt:begin reroute:loki:stream:{app="shop", component="worker", level="debug", service_name="shop"} scan=1 evidence=f3e6f52936ee
// app=shop, component=worker, level=debug: 1 unread stream, see tvt why; saves 0.04 USD/month
loki.relabel "tvt_hot" {
  rule {
    source_labels = ["app", "component", "level"]
    separator     = ";"
    regex         = "shop;worker;debug"
    action        = "drop"
  }
  forward_to = [loki.write.loki.receiver, loki.process.cloud.receiver]
}

loki.relabel "tvt_cold" {
  rule {
    source_labels = ["app", "component", "level"]
    separator     = ";"
    regex         = "shop;worker;debug"
    action        = "keep"
  }
  forward_to = [loki.echo.cold.receiver]
}
// tvt:end
